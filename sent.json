{
  "version": 1,
  "cycle": 1,
  "updated_at": "2026-11-20T10:35:06.646091+00:00",
  "sent": [
    {
      "uuid": "e5ce7b94-12e6-4fbb-87aa-931d58c6169a",
      "text": "在广袤的空间和无限的时间中，能与你共享同一颗行星和同一段时光，是我莫大的荣幸 —— 卡尔萨根《宇宙》",
      "date": "2026-10-30"
    },
    {
      "uuid": "0a97af92-1467-4fa5-897d-426fc94a7fcc",
      "text": "一本书上每多一个公式，就会减少一半读者 —— 霍金《名人名言》",
      "date": "2026-10-30"
    },
    {
      "uuid": "6f945c5f-a657-480c-ad32-cf23165e410d",
      "text": "闲暇阅几页 —— 精卫(万物终归向海)",
      "date": "2026-11-01"
    },
    {
      "uuid": "43574bd6-b563-45ab-9398-b09f33234f7a",
      "text": "我们登上并非我们所选择的舞台，演出并非我们所选择的剧本 —— 爱比克泰德《Enchiridion》",
      "date": "2026-11-02"
    },
    {
      "uuid": "2ceb5382-ff3b-4a86-aff2-960b3357cbba",
      "text": "忧郁是因为自己无能，烦恼是由于欲望得不到满足，暴躁是一种虚怯的表现 —— 大仲马《三个火枪手》",
      "date": "2026-11-02"
    },
    {
      "uuid": "2518f9ba-b104-45d6-9bc2-0ad3f5c4f9f3",
      "text": "死并非再生的对立面，而是作为生的一部分永存于生中 —— 村上春树",
      "date": "2026-11-04"
    },
    {
      "uuid": "5d5523d1-e586-42dd-9b7a-faf4571d1090",
      "text": "野蛮人之间人吃人，文明人之间人骗人 —— 叔本华《人生的智慧》",
      "date": "2026-11-05"
    },
    {
      "uuid": "a3aad3af-9ae9-46af-9296-ceedca152d34",
      "text": "忘掉一个人的劣根性就像把千辛万苦赚来的钱扔掉一样 —— 叔本华《人生的智慧》",
      "date": "2026-11-09"
    },
    {
      "uuid": "33d7b883-15cb-4739-90c9-3be0d1a42db4",
      "text": "很多事只是最初看起来有意义，但经过多次重复就慢慢失去了意义 —— 叔本华《人生的智慧》",
      "date": "2026-11-10"
    },
    {
      "uuid": "17090894-67b6-47bf-b7a8-dbf5d5042496",
      "text": "当我沉默的时候，我觉得很充实，当我开口说话，就感到了空虚 —— 鲁迅《野草・题辞》",
      "date": "2026-11-11"
    },
    {
      "uuid": "c14917d3-951d-41dd-9265-264663be95df",
      "text": "一棵树对人来说，只有削去了枝叶，成为了一颗原木，才是有用的，人成长的过程便是长出枝叶然后被削去的过程 —— 夜羊社",
      "date": "2026-11-11"
    },
    {
      "uuid": "c5fe8a35-a118-4300-9ab7-bbbeeceae515",
      "text": "从长远看，我们都已经死了 —— 凯恩斯《货币改革论》",
      "date": "2026-11-14"
    },
    {
      "uuid": "833a7838-c2d6-45a2-8d01-f7fe9824c9fe",
      "text": "未经审视的人生是不值得过的 —— 苏格拉底",
      "date": "2026-11-15"
    },
    {
      "uuid": "2e53c40e-f6d4-4b86-97bc-6ec883c4da41",
      "text": "人人生而自由，但却无往不在枷锁之中。自以为是其他一切主人的人，反而比其他一切更是奴隶 —— 卢梭《社会契约论》",
      "date": "2026-11-16"
    },
    {
      "uuid": "aac4ec9d-93d1-4ee8-807d-1a645b51483c",
      "text": "无论发生什么事情，哪怕是一个人成了一个没有了灵魂的躯体，那另一个人也还是要努力地工作下去 —— 居里夫人传",
      "date": "2026-11-18"
    },
    {
      "uuid": "acd4ef6e-a29a-4e72-a7a1-0c7a5781d244",
      "text": "好比一年中的春天是悠长而烦闷的，生命的春天也一样漫长而令人烦躁 —— 叔本华《人生的智慧》",
      "date": "2026-11-18"
    },
    {
      "uuid": "a8cbf7b7-c28f-4f6f-9475-7ac3236bd482",
      "text": "生活百般滋味，人生需要笑对 —— 佚名",
      "date": "2026-11-19"
    },
    {
      "uuid": "ffade48e-fbd2-4533-afd2-cd927c7fd355",
      "text": "同情是把双面有刃的利刀，不会使用的人最好别动手 —— 茨威格《同情的罪》",
      "date": "2026-11-20"
    },
    {
      "uuid": "f929443f-32f0-4e62-9cf5-c448e0e7e360",
      "text": "当别人还在沉睡的时候，你就出发吧。当别人还在挣扎的时候，你就到达吧 —— 刘媛媛《我不惧怕成为这样强硬的姑娘》",
      "date": "2026-11-20"
    }
  ]
}